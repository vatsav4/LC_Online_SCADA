; Copy this file to config.ini and fill in real values.
; config.ini is gitignored so credentials never get committed.

[SQL_LINE]
; Line-2 SQL Server only listens on this non-default port.
server = 172.25.208.39
port = 49561
database = Industry4_157
username = CHANGE_ME
password = CHANGE_ME

[ODBC]
driver = ODBC Driver 18 for SQL Server

[FILTER]
; Optional: only read log rows with this shop_id_id (leave empty for all).
shop_id =

[MAIN]
; sql   = read Station_Mapping + log table (SQL section above)
; opcua = read live tags from the SCADA's OPC UA server (OPCUA section below)
source = sql
poll_interval = 2
; 5000 is used by the Line-3 andon dashboard.
web_port = 5001
line_title = Line - 2 | Assembly Shop
; Image in static/ shown on the station page (e.g. chassis.png).
chassis_image = chassis.svg
; true = run on built-in sample rows, no database needed.
demo_mode = false

[OPCUA]
; Only used when [MAIN] source = opcua.
; WinCC V7.x OPC UA server default port is 4862
endpoint = opc.tcp://SCADA_IP:4862
; Leave empty for anonymous login.
username =
password =
; Empty = no security. Otherwise e.g. Basic256Sha256,SignAndEncrypt,client_cert.der,client_key.pem
security =
; SCADA pushes changes no faster than this (1000 ms is plenty for a display).
publishing_interval_ms = 1000
retry_seconds = 10
tag_map = tag_map.csv
; Values of a status tag that mean OK, and of a mode tag that mean BYPASS.
ok_values = 1,true,ok
bypass_values = 1,true,bypass
; true = VC/MAT come from SQL Station_Mapping when tag_map.csv has no vc/mat rows.
mat_from_sql = false
