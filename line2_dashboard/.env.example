# Copy to line2_dashboard/.env and fill in.
LINE_NAME=Line 2

# Line 2 SQL Server (only reachable on port 49561)
DB_HOST=172.25.208.39
DB_PORT=49561
DB_NAME=Industry4_157
DB_USER=sa
DB_PASSWORD=change-me

# pyodbc (needs "ODBC Driver 17/18 for SQL Server") or pymssql (pure pip install)
DB_BACKEND=pyodbc
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
DB_ENCRYPT=false

MAPPING_TABLE=dbo.Station_Mapping
LOG_TABLE=dbo.smartapp_linedata_line_log_dump

# Optional: restrict the log table to this line's shop_id_id
SHOP_ID=
# Optional: ignore log rows older than N hours (0 = no limit)
LOOKBACK_HOURS=0
STRICT_STATION_MATCH=true

REFRESH_SECONDS=5
EVENTS_LIMIT=50
DEMO_MODE=false

HOST=0.0.0.0
PORT=5002
