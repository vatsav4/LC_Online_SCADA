; Copy this file to config.ini and fill in real values.
; config.ini is gitignored so credentials never get committed.

[SQL_LINE]
; Line-2 SQL Server only listens on this non-default port.
server = 172.25.208.39
port = 49561
database = Industry4_157
username = CHANGE_ME
password = CHANGE_ME

[ODBC]
driver = ODBC Driver 18 for SQL Server

[MAIN]
poll_interval = 2
; 5000 is used by the Line-3 andon dashboard.
web_port = 5001
line_title = Line - 2 | Assembly Shop
; Station tiles / pages 1..total_stations (templates/station_<n>.html).
total_stations = 17
; true = run on built-in sample data, no database needed.
demo_mode = false
