; Copy this file to config.ini and fill in real values.
; config.ini is gitignored so credentials never get committed.

[SQL_LINE]
; Line-2 SQL Server only listens on this non-default port.
server = 172.25.208.39
port = 49561
database = Industry4_157
username = CHANGE_ME
password = CHANGE_ME

[ODBC]
driver = ODBC Driver 18 for SQL Server

[MAIN]
; torques = Station_Mapping + Torques_Actual_Data (written by the WinCC script in wincc/)
; logdump = Station_Mapping + the older smartapp_linedata_line_log_dump table
source = torques
poll_interval = 2
; 5000 is used by the Line-3 andon dashboard.
web_port = 5001
line_title = Line - 2 | Assembly Shop
; Chassis picture for stations whose layout doesn't choose one (in static/chassis/ or uploaded).
chassis_image = chassis-top.svg
; Signs manager login sessions. Leave empty to generate one automatically in data/.
secret_key =
; true = run on built-in sample rows, no database needed.
demo_mode = false

[FILTER]
; Only for source = logdump: only read log rows with this shop_id_id (empty = all).
shop_id =
